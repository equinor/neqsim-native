{
  "name": "NeqSim Native (GraalVM 25)",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // GraalVM native-image compilation requires significant memory.
  // The default 2-core machine (~6 GB) will OOM during the analysis phase.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  // GraalVM 25 includes native-image out of the box.
  // Maven is provided by the wrapper (mvnw) in java_graal/.
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "graal",
      "installMaven": "false",
      "installGradle": "false"
    }
  },

  // Environment variables available in every terminal session.
  // NEQSIM_TARGET points to the directory containing neqsim.so and headers after a native build.
  "containerEnv": {
    "NEQSIM_TARGET": "${containerWorkspaceFolder}/java_graal/target"
  },

  // Verify that GraalVM and native-image are installed, then run unit tests.
  "postCreateCommand": "java -version && native-image --version && cd java_graal && ./mvnw verify -ntp",

  "customizations": {
    "vscode": {
      "settings": {
        "java.configuration.detectJdksAtStart": true
      },
      "extensions": [
        "vscjava.vscode-java-pack",
        "ms-vscode.cpptools-extension-pack",
        "GitHub.copilot"
      ]
    }
  },
  "remoteUser": "vscode"
}
