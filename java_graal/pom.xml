<?xml version="1.0" encoding="UTF-8"?>
<project 
    xmlns="http://maven.apache.org/POM/4.0.0" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>com.equinor.neqsim</groupId>
    <artifactId>neqsim</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <graalvm.svm.version>25.0.0</graalvm.svm.version>
        <graalvm.buildtools.version>0.10.6</graalvm.buildtools.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.equinor.neqsim</groupId>
            <artifactId>neqsim</artifactId>
            <version>3.0.26</version>
        </dependency>
        <!-- GraalVM Substrate VM (provides @CEntryPoint, CDoublePointer, etc.) -->
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>graal-sdk</artifactId>
            <version>${graalvm.svm.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Polyglot API (Context, Source, Value — used by PythonProcessRunner) -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graalvm.svm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.12.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <fork>true</fork>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <excludedGroups>integration</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>neqsim.util.WaterDewPoint</mainClass>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- ============================================================
             with-python: Adds GraalPy runtime for Python process models.
             Activate alongside a native-* profile, e.g.:
               ./mvnw -Pnative-linux,with-python package
             ============================================================ -->
        <profile>
            <id>with-python</id>
            <dependencies>
                <dependency>
                    <groupId>org.graalvm.polyglot</groupId>
                    <artifactId>python-community</artifactId>
                    <version>${graalvm.svm.version}</version>
                    <type>pom</type>
                </dependency>
            </dependencies>
        </profile>

        <!-- ============================================================
             Default "lean" builds (no Python — recommended)
             Activate explicitly:
               ./mvnw -Pnative-linux-lean package
               mvnw.cmd -Pnative-windows-lean package
               ./mvnw -Pnative-macos-lean package
             ============================================================ -->
        <profile>
            <id>native-linux-lean</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${graalvm.buildtools.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-shared-lib-linux-lean</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <configuration>
                                    <excludeTestClasses>true</excludeTestClasses>
                                    <agent>
                                        <enabled>false</enabled>
                                    </agent>
                                    <mainClass>neqsim.util.WaterDewPoint</mainClass>
                                    <sharedLibrary>true</sharedLibrary>
                                    <imageName>neqsim</imageName>
                                    <debugSymbols>true</debugSymbols>
                                    <debug>true</debug>
                                    <buildArgs>
                                        <buildArg>--no-fallback</buildArg>
                                        <buildArg>-g</buildArg>
                                        <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                        <buildArg>-H:+TrackPrimitiveValues</buildArg>
                                        <buildArg>-H:+UsePredicates</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>native-macos-lean</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${graalvm.buildtools.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-shared-lib-macos-lean</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <configuration>
                                    <excludeTestClasses>true</excludeTestClasses>
                                    <agent>
                                        <enabled>false</enabled>
                                    </agent>
                                    <mainClass>neqsim.util.WaterDewPoint</mainClass>
                                    <sharedLibrary>true</sharedLibrary>
                                    <imageName>neqsim</imageName>
                                    <debugSymbols>true</debugSymbols>
                                    <debug>true</debug>
                                    <buildArgs>
                                        <buildArg>--no-fallback</buildArg>
                                        <buildArg>-g</buildArg>
                                        <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>native-windows-lean</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${graalvm.buildtools.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-shared-lib-windows-lean</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <configuration>
                                    <excludeTestClasses>true</excludeTestClasses>
                                    <agent>
                                        <enabled>false</enabled>
                                    </agent>
                                    <mainClass>neqsim.util.WaterDewPoint</mainClass>
                                    <sharedLibrary>true</sharedLibrary>
                                    <imageName>neqsim</imageName>
                                    <debugSymbols>true</debugSymbols>
                                    <debug>true</debug>
                                    <buildArgs>
                                        <buildArg>--no-fallback</buildArg>
                                        <buildArg>-g</buildArg>
                                        <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ============================================================
             With-Python builds (use alongside with-python profile)
             Activate explicitly:
               ./mvnw -Pnative-linux,with-python package
               mvnw.cmd -Pnative-windows,with-python package
               ./mvnw -Pnative-macos,with-python package
             ============================================================ -->
        <profile>
            <id>native-linux</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${graalvm.buildtools.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-shared-lib-linux</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <configuration>
                                    <excludeTestClasses>true</excludeTestClasses>
                                    <agent>
                                        <enabled>false</enabled>
                                    </agent>
                                    <mainClass>neqsim.util.WaterDewPoint</mainClass>
                                    <sharedLibrary>true</sharedLibrary>
                                    <imageName>neqsim</imageName>
                                    <debugSymbols>true</debugSymbols>
                                    <debug>true</debug>
                                    <buildArgs>
                                        <buildArg>--no-fallback</buildArg>
                                        <buildArg>-g</buildArg>
                                        <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                        <buildArg>-H:+TrackPrimitiveValues</buildArg>
                                        <buildArg>-H:+UsePredicates</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>native-macos</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${graalvm.buildtools.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-shared-lib-macos</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <configuration>
                                    <excludeTestClasses>true</excludeTestClasses>
                                    <agent>
                                        <enabled>false</enabled>
                                    </agent>
                                    <mainClass>neqsim.util.WaterDewPoint</mainClass>
                                    <sharedLibrary>true</sharedLibrary>
                                    <imageName>neqsim</imageName>
                                    <debugSymbols>true</debugSymbols>
                                    <debug>true</debug>
                                    <buildArgs>
                                        <buildArg>--no-fallback</buildArg>
                                        <buildArg>-g</buildArg>
                                        <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>native-windows</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${graalvm.buildtools.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-shared-lib-windows</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <configuration>
                                    <excludeTestClasses>true</excludeTestClasses>
                                    <agent>
                                        <enabled>false</enabled>
                                    </agent>
                                    <mainClass>neqsim.util.WaterDewPoint</mainClass>
                                    <sharedLibrary>true</sharedLibrary>
                                    <imageName>neqsim</imageName>
                                    <debugSymbols>true</debugSymbols>
                                    <debug>true</debug>
                                    <buildArgs>
                                        <buildArg>--no-fallback</buildArg>
                                        <buildArg>-g</buildArg>
                                        <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ============================================================
             Server EXE build (for 32-bit stub support — Windows only)
             Builds a standalone executable (not a shared library) that
             hosts the NeqSim process models behind a TCP server.
             Activate explicitly:
               mvnw.cmd -Pnative-server-windows package
               mvnw.cmd -Pnative-server-windows,with-python package
             ============================================================ -->
        <profile>
            <id>native-server-windows</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${graalvm.buildtools.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-server-exe-windows</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <configuration>
                                    <excludeTestClasses>true</excludeTestClasses>
                                    <agent>
                                        <enabled>false</enabled>
                                    </agent>
                                    <mainClass>neqsim.server.NeqSimPipeServer</mainClass>
                                    <sharedLibrary>false</sharedLibrary>
                                    <imageName>neqsim_server</imageName>
                                    <buildArgs>
                                        <buildArg>--no-fallback</buildArg>
                                        <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
